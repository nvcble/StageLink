; StageLink monorepo npm configuration.
; Hoisting is left at npm's default so that Electron's native binary and the
; Nuxt toolchain resolve from the workspace root.
save-exact=false
fund=false
audit=false
; electron-builder and @nuxt/ui pull a number of optional peer dependencies we
; deliberately do not install (tiptap, ai, joi, yup, ...). Do not let npm fail
; the install over peers we never import.
legacy-peer-deps=false
strict-peer-deps=false
