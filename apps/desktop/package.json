{
  "name": "@stagelink/desktop",
  "productName": "StageLink Core",
  "version": "0.1.0",
  "private": true,
  "description": "StageLink Core — wireless in-ear monitoring for the stage.",
  "author": {
    "name": "StageLink"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "concurrently -k -n nuxt,electron -c cyan,magenta \"npm:dev:nuxt\" \"npm:dev:electron\"",
    "dev:nuxt": "nuxt dev --host 127.0.0.1 --port 3579",
    "dev:electron": "npm run build:electron && wait-on -t 90000 http-get://127.0.0.1:3579 && cross-env NODE_ENV=development electron .",
    "build:electron": "tsup --config electron.tsup.config.ts",
    "build:nuxt": "nuxt generate",
    "build": "npm run build:electron && npm run build:nuxt",
    "package": "electron-builder --win --x64 --config electron-builder.config.cjs",
    "package:dir": "electron-builder --win --x64 --dir --config electron-builder.config.cjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.electron.json && vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stagelink/shared-protocol": "*",
    "electron-log": "^5.4.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxt/ui": "^4.11.3",
    "@pinia/nuxt": "^1.0.2",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^21.0.1",
    "nuxt": "^4.6.1",
    "pinia": "^4.0.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.5.1",
    "zod": "^4.6.6"
  }
}
