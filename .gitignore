*.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.log
tests/**/recordings/
# Smoke-test window captures and received audio are build output.
tests/integration/artifacts/

# Environment / secrets
.env
.env.*
!.env.example

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Misc
*.tsbuildinfo
coverage/
.eslintcache

